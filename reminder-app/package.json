{
  "name": "remember-reminders",
  "version": "0.5.0",
  "private": true,
  "description": "Original link_app with shared Google login and integrated reminders",
  "author": "jush-website",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5174 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4174 --strictPort",
    "test": "node --test tests/*.test.js",
    "test:ui": "playwright test",
    "test:sync": "node scripts/test-sync.cjs",
    "lint": "eslint src tests electron scripts vite.config.js playwright*.config.js",
    "desktop": "npm run build && electron .",
    "package:windows": "npm run build && node scripts/package-windows.cjs",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/app": "8.0.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/preferences": "8.0.1",
    "firebase": "12.11.0",
    "lucide-react": "1.7.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/cli": "8.5.2",
    "@eslint/js": "9.39.4",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "6.0.1",
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "firebase-tools": "^15.32.1",
    "globals": "17.4.0",
    "vite": "8.0.3"
  },
  "build": {
    "appId": "com.jush.remember",
    "productName": "Remember",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/model.js",
      "src/desktopSchedule.js",
      "src/updates.js",
      "package.json"
    ],
    "win": {
      "target": "zip",
      "signAndEditExecutable": false
    },
    "asar": true
  }
}
